MONGODB_URL=mongodb://localhost:27017/healthcare_db
DATABASE_NAME=healthcare_db
SECRET_KEY=change-this-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ML_MODELS_PATH=./ml_models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# DEBUG=true → Forgot Password OTP shown on screen (no Gmail needed)
DEBUG=true

# SMTP optional — only for sending OTP to real email inbox
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_USE_SSL=false
